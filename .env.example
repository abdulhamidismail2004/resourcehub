# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# When DATABASE_URL is left empty or set to 'local', ResourceHub automatically runs with embedded PostgreSQL (PGlite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resourcehub

# Security & Sessions
SESSION_SECRET=supersecret-session-secret-change-this-in-production-min-32-chars
COOKIE_SECRET=supersecret-cookie-secret-change-this-in-production-min-32-chars

# Storage Configuration
# Options: 'local' | 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# S3 Configuration (when STORAGE_DRIVER=s3, e.g. MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resourcehub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Initial Admin Credentials (used during db:seed)
INITIAL_ADMIN_EMAIL=admin@resourcehub.edu
INITIAL_ADMIN_PASSWORD=AdminPassword123!
