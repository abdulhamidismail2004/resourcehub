{
  "name": "resourcehub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Educational Resource Sharing Platform",
  "scripts": {
    "install:all": "cd packages/shared && npm install && npm run build && cd ../../apps/api && npm install && cd ../../apps/web && npm install",
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "test:api": "npm run test --prefix apps/api",
    "test:web": "npm run test --prefix apps/web",
    "test": "npm run test:api && npm run test:web",
    "db:migrate": "npm run db:migrate --prefix apps/api",
    "db:seed": "npm run db:seed --prefix apps/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vercel/node": "^3.2.32",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
